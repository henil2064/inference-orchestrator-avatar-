# Media-edge configuration. Copy this file to `.env` in this directory.
# CLI flags override shell environment variables, which override this file.

# --- terminal output ---
LOG_LEVEL=ERROR
STARTUP_BANNER=1
EDGE_CONNECTION_EVENTS=0
VAD_DEBUG=0

# --- service endpoints ---
EDGE_ADDR=:8443
EDGE_ORCHESTRATOR=localhost:50051
EDGE_METRICS_ADDR=:9101
EDGE_MAX_SESSIONS=0
# EDGE_ALLOWED_ORIGINS=https://host.example,https://192.168.1.10:8443

# --- HTTPS and VAD ---
EDGE_CERT_DIR=certs
# Set to 1 only for localhost development. Browsers require HTTPS for remote mic access.
EDGE_NO_TLS=0
# EDGE_PROFILE=/path/to/profile.json
# EDGE_ONNX_LIB=third_party/onnxruntime/libonnxruntime.so
# EDGE_VAD_MODEL=models/silero_vad.onnx

# --- avatar video (optional) ---
# gRPC address of the avatar service (see avatar/README.md). Unset = audio-only:
# no video track is negotiated and agent audio is not delayed.
# EDGE_AVATAR_TARGET=localhost:50056
# Portrait/background to request; empty uses the avatar service's defaults.
# EDGE_AVATAR_ID=
# EDGE_AVATAR_BG=
# With an avatar, agent audio is held back so the video rendered from it can
# keep up: by the service's lookahead (405 ms for AVTR-1) plus this margin for
# render, encode and transport. Raise it if edge_avatar_late_frames_total
# climbs; lower it to shave reply latency once the GPU is measured.
# EDGE_AVATAR_RENDER_MARGIN_MS=200
# Or set the whole delay outright (0 = lookahead + margin).
# EDGE_AVATAR_DELAY_MS=0

# --- agent-audio playout (outbound Opus track) ---
# Jitter cushion the edge prebuffers before it starts emitting agent speech, and
# rebuilds if it runs dry. Larger = smoother/steadier playback, more latency.
EDGE_PLAYOUT_PREBUFFER_MS=200
# Cap on buffered agent audio (memory bound when TTS outruns real-time playback).
EDGE_PLAYOUT_MAX_MS=30000
# Bound how long short clauses wait for the prebuffer to fill.
EDGE_PLAYOUT_MAX_STALL_MS=400
