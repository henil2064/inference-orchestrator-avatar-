# Copy to `.env` (same folder as server.py) — server.py auto-loads it on startup.
# Real environment / CLI vars override anything set here.

# --- required ---
# Bare .gguf file, OR a directory containing one + config.json (directory form
# works around a vLLM engine-construction bug — see server.py's load_engine()).
LLM_MODEL_PATH=/path/to/medgemma-4b-it-quant-dir

# --- optional ---
# LLM_TOKENIZER=google/medgemma-4b-it   # HF repo id for tokenizer + chat template.
                                         # google/medgemma-4b-it is a GATED repo — this
                                         # needs `huggingface-cli login` with an account
                                         # that's accepted the license, OR point this at a
                                         # LOCAL directory containing tokenizer.json,
                                         # tokenizer.model, tokenizer_config.json,
                                         # special_tokens_map.json, added_tokens.json,
                                         # chat_template.jinja (no network call needed then).
# LLM_ADDR=[::]:50053
# LLM_SYSTEM_PROMPT=You are a helpful, concise voice assistant. Keep replies short and natural to speak aloud.
# LLM_MAX_TOKENS=512
# Input history uses at most model context - max output - this safety reserve.
# Oldest complete turns are removed first if the rendered prompt is too large.
# LLM_CONTEXT_SAFETY_TOKENS=128
# LLM_TEMPERATURE=0.7
# LLM_ENABLE_THINKING=1           # 1 = let the model emit a <think>...</think> reasoning
                                   # block before its reply. Default OFF: a voice agent
                                   # wants a short spoken answer, not a visible reasoning
                                   # trace, and thinking tokens add real latency. Only
                                   # Qwen3-family chat templates act on this; harmless
                                   # no-op otherwise.
# LLM_MAX_MODEL_LEN=4096          # vLLM defaults to the model's own context (131072 for
                                   # Gemma3/MedGemma) if unset — the KV cache it tries to
                                   # pre-allocate for that on a small GPU will very likely
                                   # OOM. Set this explicitly on VRAM-constrained boxes.
# LLM_GPU_MEMORY_UTILIZATION=0.85 # bounds the KV cache only — see LLM_MAX_NUM_BATCHED_TOKENS
# LLM_MAX_NUM_BATCHED_TOKENS=512  # caps the chunked-prefill scratch buffer, which is
                                   # NOT covered by GPU_MEMORY_UTILIZATION and can OOM on
                                   # its own on a small/fp32-forced card. Default (unset)
                                   # is vLLM's own heuristic (e.g. 2048) — lower this first
                                   # if you see one large allocation fail at startup.
# LLM_QUANTIZATION=               # leave unset (default) — vLLM auto-detects GGUF; "gguf" is REJECTED as an explicit value
# LLM_ENFORCE_EAGER=1             # 1 = skip CUDA graph capture — frees the upfront memory
                                   # graph capture reserves at startup; try this FIRST on a
                                   # tight-VRAM card (slower per-token, but it runs at all)
# LLM_METRICS_PORT=9104
# CUDA_VISIBLE_DEVICES=0
