# Local defaults for llm/server_unsloth.py. Real env / CLI vars override these.

LLM_HF_REPO_ID=unsloth/medgemma-1.5-4b-it-GGUF
LLM_MODEL_DIR=./models/unsloth/medgemma-1.5-4b-it-GGUF
LLM_GGUF_FILE=medgemma-1.5-4b-it-Q4_K_S.gguf
LLM_AUTO_DOWNLOAD=1

LLM_ADDR=[::]:50053
LLM_METRICS_PORT=9105
LLM_SYSTEM_PROMPT=You are a helpful, concise voice assistant. Keep replies short and natural to speak aloud.

LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0.5
LLM_TOP_P=0.9
LLM_REPEAT_PENALTY=1.05

LLM_N_CTX=2048
LLM_N_BATCH=128
LLM_N_UBATCH=64
LLM_N_GPU_LAYERS=20
LLM_N_THREADS=4
LLM_MAIN_GPU=0
LLM_USE_MLOCK=0
LLM_VERBOSE=0
CUDA_VISIBLE_DEVICES=0
