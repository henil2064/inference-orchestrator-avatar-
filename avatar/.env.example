# Avatar service configuration. Copy to avatar/.env; shell values win.
LOG_LEVEL=ERROR

AVATAR_ADDR=[::]:50056
AVATAR_METRICS_HOST=0.0.0.0
AVATAR_METRICS_PORT=9105

# avtr1 is the real model (needs ./avatar/setup.sh and an Ampere+ NVIDIA GPU).
# synthetic draws an audio-reactive test card with no model at all, for wiring
# up the edge and checking lip-sync on a machine without a GPU.
AVATAR_BACKEND=avtr1

# Portrait and background used when the edge does not ask for specific ones.
# Ids are file stems under the artifacts' avatars_artifacts/ directories.
AVATAR_DEFAULT_ID=maria
AVATAR_DEFAULT_BG=plain_white
# Portraits to load at startup. Unset loads only AVATAR_DEFAULT_ID, which keeps
# startup short; a comma-separated list or "all" loads more.
# AVATAR_IDS=maria,doctor
# Directory of {avatar_id}.png portraits, if not the downloaded reference set.
# AVATAR_PORTRAITS_DIR=/path/to/portraits

# Output frame size. 1280x720 is what upstream builds and tests at.
AVATAR_OUT_WIDTH=1280
AVATAR_OUT_HEIGHT=720

# Sessions share one GPU worker a chunk at a time. A chunk covers 200 ms of
# video, so capacity is roughly 200 / (measured ms per chunk), minus headroom.
# Check the startup banner and avatar_chunk_render_seconds before raising this.
AVATAR_MAX_SESSIONS=2
# Chunks a session may fall behind before the oldest are skipped. Skipping
# freezes the picture briefly; not skipping lets video drift behind the audio.
AVATAR_MAX_BACKLOG_CHUNKS=2

# H.264 encoders to try, in order. NVENC keeps encoding on the GPU; libx264 is
# the CPU fallback and what the synthetic backend uses.
AVATAR_VIDEO_CODECS=h264_nvenc,libx264
AVATAR_VIDEO_BITRATE=1500000
AVATAR_GOP_SECONDS=2

# Render two silent chunks at startup so the first caller does not pay
# TensorRT's first-use allocation, and report the measured ms/chunk.
AVATAR_WARMUP=1

# Where upstream keeps artifacts and built engines. Defaults to
# avatar/third_party/avtr-1/artifacts; set it for setup.sh AND the service.
# AVTR1_LOCAL_STORAGE=/var/lib/avtr1/artifacts
