# DhVaani TTS service configuration. Copy to tts/.env; shell values win.
LOG_LEVEL=ERROR
STARTUP_BANNER=1

# The downloaded DhVaani directory in this repository is a valid default when
# running from the checkout. Set an absolute path when models live elsewhere.
# A path ending in .gguf selects the llama.cpp backend (MioTTS-family, e.g.
# SPRINGLab/Indic-Mio); anything else uses the bare-PyTorch DhVaani backend.
# Override auto-detection with TTS_FORMAT=gguf|pytorch if needed.
# GGUF backend deps: pip install llama-cpp-python transformers \
#   git+https://github.com/Aratako/MioCodec
# GGUF backend clones TTS_PROMPT_WAV (encoded once for the codec's speaker
# embedding); TTS_PROMPT_TEXT is unused by it (text-only prompt).
TTS_MODEL_DIR=./models/DhVaani-0.5-fp16
# TTS_FORMAT=
# llama.cpp/GGUF (MioTTS) backend only:
# TTS_N_GPU_LAYERS=0            # >0 offloads the backbone LM to CUDA
# TTS_N_CTX=8192
# TTS_LLAMACPP_TEMPERATURE=0.9
# TTS_TOP_P=0.9
# TTS_MAX_AUDIO_TOKENS=1500     # ~25 tokens/sec at 25 Hz -> ~60 s cap
# TTS_MIOCODEC=Aratako/MioCodec-25Hz-24kHz
# TTS_GGUF_TOKENIZER=SPRINGLab/Indic-Mio   # chat-template source; defaults to the .gguf's dir then this
# TTS_SPEECH_OFFSET=151669      # audio-token base id in the LM vocab
# TTS_CODEBOOK_SIZE=12800
# A clean 3–10 s mono reference clip and its exact transcript. These identify
# the one voice the service is allowed to render.
TTS_PROMPT_WAV=/path/to/reference.wav
TTS_PROMPT_TEXT=Reference voice transcript here

TTS_ADDR=[::]:50054
TTS_METRICS_HOST=0.0.0.0
TTS_METRICS_PORT=9104
TTS_DEVICE=auto
# CPU-only tuning: pin torch intra-op threads (0 = leave torch default). Set to the
# physical core count when TTS owns the box; lower it when co-located with other services.
# 4 is the measured throughput plateau for this backend (docs/
# CPU_PROFILING_REPORT.md); higher buys nothing and only adds contention with
# whatever else shares the box (STT/LLM/orchestrator/media-edge).
TTS_NUM_THREADS=4
# 16 is highest quality; 8 reduces latency at some quality cost.
TTS_NUM_STEP=16
TTS_GUIDANCE_SCALE=1.0
TTS_SPEED=1.0
# Cached at startup: the reference WAV is decoded and conditioned once, not per reply.
TTS_WARMUP=1
# Bound resource use. A request waits at most this long for the single GPU worker.
TTS_MAX_TEXT_CHARS=2000
# A single synthesis worker is the whole capacity: a deep wait queue on top
# of it turns into multi-second-plus TTFA under concurrency rather than just
# delayed audio. Keep this small and let ORCH_MAX_SESSIONS/
# ORCH_MAX_ACTIVE_TURNS reject early instead. Raise once TTS actually runs on
# GPU (TTS_N_GPU_LAYERS>0 with a CUDA-built llama-cpp-python).
TTS_MAX_QUEUE=1
TTS_QUEUE_TIMEOUT_S=15
# Phase 3 wedge detection: how long the single synthesis worker may run
# before gRPC health flips to NOT_SERVING (synthesis can't be preempted, so
# this is the only self-report signal).
TTS_WEDGE_TIMEOUT_S=30
