# Orchestrator configuration. Copy this file to `.env` in this directory.
# Shell environment variables take precedence over values in this file.

# --- terminal output ---
LOG_LEVEL=ERROR
STARTUP_BANNER=1

# --- service endpoints ---
# STT_TARGET=localhost:50052
# LLM_TARGET=localhost:50053
# TTS_TARGET=localhost:50054
# ORCH_METRICS_HOST=0.0.0.0
# ORCH_METRICS_PORT=9102
# Phase 3 replica fan-out: comma-separated address lists, set by
# scripts/run_pipeline.py when running more than one STT/TTS replica. Take
# priority over STT_TARGET/TTS_TARGET above when set; leave unset for a
# single-instance run. LLM stays single-target (one vLLM instance).
# STT_TARGETS=localhost:50052,localhost:50152
# TTS_TARGETS=localhost:50054,localhost:50154

# --- session store (required) ---
# Start Redis from the repository root: `docker compose up -d redis`.
REDIS_URL=redis://127.0.0.1:6379/0
REDIS_ACTIVE_TTL_S=86400
REDIS_CLOSED_TTL_S=604800
REDIS_EVENT_MAXLEN=2000
# Storage health (Phase 3): a sized connection pool and bounded per-op waits,
# so a slow -- not just refused -- Redis can never hang a live call. Raise
# REDIS_POOL_SIZE alongside ORCH_MAX_SESSIONS on a bigger box.
REDIS_POOL_SIZE=128
REDIS_OP_TIMEOUT_S=3
REDIS_CONNECT_TIMEOUT_S=3
# How many completed turns Redis retains per session, trimmed atomically on
# every write. Deliberately larger than LLM_HISTORY_MAX_TURNS below and
# independent of it -- this bounds storage, not prompt context.
REDIS_TURN_RETENTION=50

# --- turn routing ---
# Set STT_VAD_GATE=0 only to forward all audio during diagnostics.
STT_VAD_GATE=1
STT_VAD_PREROLL_MS=300
# Set LLM_ENABLED=0 to run the edge-to-STT path without an LLM service.
LLM_ENABLED=1
TTS_ENABLED=1
# Deadline for one full unary TTS response. Keep it below the interactive turn SLA.
TTS_TIMEOUT_S=45
LLM_HISTORY_MAX_TURNS=6
# After the edge stops sending, keep relaying this long so an in-flight reply's
# audio finishes reaching the edge (which half-closes and waits ~12s). Bounds a
# hung backend so the RPC can't wedge open.
ORCH_FINAL_TURN_WAIT_S=12

# --- backpressure, admission, and pipelining ---
# Size these to the slowest backend's real measured capacity, not a round
# number -- a single-worker CPU TTS backend at RTF ~0.8 (docs/
# CPU_PROFILING_REPORT.md) sustains roughly one real-time conversation, so
# admitting far more than that just moves the wait into TTFA instead of
# rejecting up front. Recompute after any TTS capacity change (e.g. GPU offload).
ORCH_MAX_SESSIONS=4
ORCH_MAX_ACTIVE_TURNS=1
ORCH_MAX_QUEUED_TURNS=12
ORCH_TURN_ADMISSION_TIMEOUT_S=10
ORCH_TURN_DEADLINE_S=30
# Bounded per-session buffers: a full queue backpressures the edge via gRPC flow
# control instead of growing memory. Frames are ~20ms, so 400 holds a few seconds.
ORCH_INBOUND_QUEUE_MAX=400
ORCH_STT_QUEUE_MAX=400
ORCH_OUTBOUND_QUEUE_MAX=400
# LLM->TTS pipelining: clauses buffered between the token stream and per-clause
# TTS, and the char length at which a punctuation-free run is force-flushed.
ORCH_CLAUSE_QUEUE_MAX=4
ORCH_MAX_CLAUSE_CHARS=240
# Let the turn's first clause flush early (at a comma/semicolon/colon, or at
# this many characters, whichever comes first) instead of waiting for real
# sentence punctuation. Short replies often have no sentence boundary until
# the very last token, so without this the LLM stream and TTS never overlap.
# 0 disables early flushing and restores plain sentence-only splitting.
ORCH_FIRST_CLAUSE_CHARS=50

# --- optional ClickHouse development telemetry ---
# Start it from the repository root: `docker compose up -d clickhouse`.
CLICKHOUSE_ENABLED=1
CLICKHOUSE_URL=http://127.0.0.1:8123
CLICKHOUSE_DATABASE=pipeline
CLICKHOUSE_QUEUE_MAX=10000
CLICKHOUSE_BATCH_SIZE=100
CLICKHOUSE_FLUSH_INTERVAL_S=0.25
