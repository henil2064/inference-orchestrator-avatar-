# STT service configuration. Copy this file to `.env` in this directory.
# Shell environment variables take precedence over values in this file.

# --- terminal output ---
LOG_LEVEL=ERROR
STARTUP_BANNER=1
# Transcript text is privacy-sensitive: none, partials, finals, or both.
STT_TRANSCRIPT_LOG=none

# --- model/runtime selection ---
# Default retains the existing SraVaani TorchScript/Transformers runtime.
STT_RUNTIME=transformers       # transformers or onnx
# --- Transformers model path (required when STT_RUNTIME=transformers) ---
# Directory containing the SraVaani model files, including model-asr.fp16.ts.
SRAVAANI_MODEL=/path/to/SraVaani_portable/model
# STT_MODEL_DIR=/path/to/SraVaani_portable/model  # preferred alias; overrides SRAVAANI_MODEL

# --- ONNX model (used only when STT_RUNTIME=onnx) ---
# Defaults to the bundled model directory for the selected variant.
# STT_ONNX_MODEL_DIR=/path/to/sravaani-onnx
STT_ONNX_VARIANT=int8          # int8, fp8, or fp16
STT_ONNX_PROVIDER=auto         # auto, cpu, or cuda

# --- service endpoints and compute ---
STT_ADDR=[::]:50052
STT_METRICS_HOST=0.0.0.0
STT_METRICS_PORT=9103
# CUDA_VISIBLE_DEVICES=1
# STT_DEVICE=auto             # auto, cpu, or cuda
# Left unset, onnxruntime's own default (physical core count) is ~10% faster
# than any explicit value (docs/CPU_PROFILING_REPORT.md) -- but it also means
# STT claims every physical core by default. STT costs ~25x less per session
# than TTS, so setting this to 4 trades that ~10% for cores freed to TTS/LLM/
# media-edge, which is where capacity actually matters.
STT_CPU_THREADS=4

# --- bounded-segment cutting ---
STT_MAX_SEGMENT_SEC=8.0
STT_SEGMENT_GRACE_SEC=2.0
STT_QUIET_SCAN_SEC=1.0
STT_QUIET_RMS_THRESHOLD=400
# Require this much contiguous low-energy audio before cutting mid-turn.
STT_QUIET_MIN_SEC=0.06
# Protect the single GPU worker during concurrent streams.
STT_MAX_INFLIGHT=8
# Bound buffered-but-not-yet-transcribed segments per stream.
STT_SEGMENT_QUEUE_MAX=4
STT_SEGMENT_QUEUE_MAX_AGE_SEC=20
# Pay startup cost to warm every whole-second segment shape (1..max+grace).
STT_WARM_ALL_BUCKETS=1
# Phase 3 wedge detection: how long the single GPU worker's current forward
# may run before gRPC health flips to NOT_SERVING (a native forward can't be
# preempted, so this is the only self-report signal). Defaults to
# STT_MAX_SEGMENT_SEC + STT_SEGMENT_GRACE_SEC, which already has generous
# slack over real compute time.
STT_WEDGE_TIMEOUT_S=10

# --- optional terminal profiling ---
STT_LOG_INFERENCE=0
STT_PROFILE_RES=0
STT_PROFILE_INTERVAL=5
