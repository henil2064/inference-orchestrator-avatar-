# Adaptive LLM configuration. Copy this file to `.env` in this directory.
# Shell environment variables override this file.

# --- terminal output and privacy-sensitive request logging ---
LOG_LEVEL=ERROR
STARTUP_BANNER=1
VLLM_LOGGING_LEVEL=ERROR
ADAPTIVE_LLM_LOG_EXCHANGES=0
ADAPTIVE_LLM_PROFILE_INFERENCE=0
ADAPTIVE_LLM_LOG_MAX_CHARS=800

# --- service endpoints and model selection ---
# A Hugging Face repository is the normal selector. The service caches it under
# adaptive_llm/models/huggingface/ and only downloads it when absent.
# LLM_MODEL_REF=Qwen/Qwen3-0.6B
# LLM_MODEL_FILE=model-Q4_K_M.gguf  # required when a GGUF repo has several files
# Selecting a GGUF does not force llama.cpp: vLLM serves a single-file GGUF too,
# and on a CUDA GPU the planner normally prefers it. That path needs the
# repository the GGUF was converted from (tokenizer, chat template, and the
# config fields the conversion drops). It is taken from LLM_TOKENIZER, else a
# model-profiles.json entry, else the base model the GGUF records itself.
# These repos are usually gated: accept their terms and set HF_TOKEN.
# See docs/VLLM_GGUF.md.
# LLM_TOKENIZER=google/medgemma-27b-it
# LLM_AUTO_DOWNLOAD=1
# LLM_MODEL_DIR=adaptive_llm/models
# HF_TOKEN=hf_...                   # optional; required for private/gated models
# LLM_MODEL_PROFILE=qwen3_0_6b_bf16 # optional JSON tuning profile
#
# Legacy local-profile selector. Omit this when using LLM_MODEL_REF.
# LLM_MODEL_ID=medgemma_1_5_4b_q4
LLM_MODEL_REF=Qwen/Qwen3-0.6B
LLM_AUTO_DOWNLOAD=1
LLM_ADDR=[::]:50053
# 50054 collides with TTS's default port (TTS_ADDR) -- keep this off that.
ADAPTIVE_LLM_WORKER_ADDR=127.0.0.1:50055
LLM_METRICS_HOST=0.0.0.0
LLM_METRICS_PORT=9106
# LLM_ENGINE=sglang          # optional override: llama.cpp, vllm, or sglang
ADAPTIVE_LLM_DRY_RUN=0
ADAPTIVE_LLM_AUTO_START_WORKER=1
ADAPTIVE_LLM_WORKER_READY_TIMEOUT_S=900

# --- planner and request admission ---
ADAPTIVE_LLM_VRAM_HEADROOM=0.15
ADAPTIVE_LLM_RAM_HEADROOM=0.10
ADAPTIVE_LLM_MIN_HEADROOM_MIB=512
ADAPTIVE_LLM_MAX_INFLIGHT_REQUESTS=4
ADAPTIVE_LLM_MAX_QUEUED_REQUESTS=16
ADAPTIVE_LLM_RESOURCE_METRICS_INTERVAL_S=5
ADAPTIVE_LLM_PROFILE_BANDWIDTH=0

# --- generation and prompt selection ---
# LLM_MAX_MODEL_LEN=2048
# LLM_MAX_TOKENS=256
LLM_PROMPT_ID=voice-assistant-v1
# LLM_PROMPTS_FILE=adaptive_llm/prompts.json
# LLM_SYSTEM_PROMPT=You are a helpful, concise voice assistant.
# LLM_CONTEXT_SAFETY_TOKENS=128
# LLM_TEMPERATURE=0.5
# LLM_ENABLE_THINKING=0

# --- engine-specific overrides (normally keep these in model-profiles.json) ---
# LLM_N_BATCH=128
# LLM_N_UBATCH=64
# LLM_TOP_P=0.9
# LLM_TOP_K=-1
# LLM_MIN_P=0.0
# LLM_REPEAT_PENALTY=1.05
# GTX 1650 / 4 GB starting point. Values in this file override the selected
# model profile; see docs/VLLM_TUNING.md before increasing them.
# LLM_GPU_MEMORY_UTILIZATION=0.70
# LLM_MAX_NUM_BATCHED_TOKENS=512
# LLM_MAX_NUM_SEQS=4
# LLM_ENABLE_PREFIX_CACHING=1  # auto-disabled for head_size 256 on pre-Ampere GPUs
# LLM_ENABLE_CHUNKED_PREFILL=1  # auto-disabled for head_size 256 on pre-Ampere GPUs
# LLM_ENFORCE_EAGER=0
# LLM_KV_CACHE_DTYPE=auto
# LLM_DTYPE=auto
# LLM_QUANTIZATION=
# LLM_DISABLE_LOG_STATS=0
# Leave VLLM_USE_V1 unset: the worker selects V0 on pre-Ampere GPUs
# (compute capability < 8.0) and V1 on newer GPUs.
# VLLM_USE_V1=0  # force V0 only when diagnosing a newer-GPU compatibility issue
# LLM_SWAP_SPACE_GIB=0
# LLM_CPU_OFFLOAD_GB=0
LLM_WORKER_METRICS_HOST=0.0.0.0
LLM_WORKER_METRICS_PORT=9114
# SGLang launches a local HTTP server behind the worker. Radix prefix caching
# is enabled by default and reuses completed conversational history.
# LLM_SGLANG_PORT=30000
# LLM_SGLANG_TIMEOUT_S=300
# Use a dedicated venv/container because SGLang's current CUDA/Torch packages
# conflict with vLLM's. Alternatively configure LLM_SGLANG_URL for an existing server.
# LLM_SGLANG_PYTHON=/opt/sglang-venv/bin/python
# LLM_SGLANG_URL=
# Useful for small/older GPUs when graph capture leaves too little VRAM.
# LLM_SGLANG_DISABLE_CUDA_GRAPH=1
# FlashInfer JIT-compiles CUDA kernels on first use with the `nvcc` found on
# PATH. If the system's default nvcc is older than what FlashInfer expects
# (e.g. a distro nvidia-cuda-toolkit package shadowing a newer NVIDIA-installed
# CUDA toolkit), kernel builds can fail with header errors unrelated to GPU
# compute capability. Point at a working toolkit here if that happens.
# LLM_SGLANG_CUDA_HOME=/usr/local/cuda-12.6
# Hybrid conv/SSM architectures (e.g. LFM2, Granite 4.0-h) cache their
# short-conv state in bf16 by default. On pre-Ampere GPUs (compute
# capability < sm80, which lack native bf16), that cache tensor mismatches
# the fp16 fallback the rest of the model already uses, and the worker
# crashes on the first request ("Tensor match failed ... dtype=bfloat16").
# Set this to force the conv-state cache dtype to match. If the model also
# has full Mamba2/GDN layers, LLM_SGLANG_MAMBA_SSM_DTYPE=float16 covers
# their separate temporal-state cache the same way.
# LLM_SGLANG_MAMBA_CONV_DTYPE=float16
# LLM_SGLANG_MAMBA_SSM_DTYPE=float16
# This text-only service disables VLM image/video encoders by default. Set to 0
# only after adding multimodal requests to the public gRPC contract.
# LLM_LANGUAGE_MODEL_ONLY=1
# PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
